    {
      "name": "1. Authentification",
      "item": [
        {
          "name": "Inscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Amira\",\n  \"last_name\": \"Benali\",\n  \"phone\": \"+212612345678\",\n  \"role\": \"student\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "if (j.access) pm.collectionVariables.set('access', j.access);",
                  "if (j.refresh) pm.collectionVariables.set('refresh', j.refresh);",
                  "pm.collectionVariables.set('user_id', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const j = pm.response.json();",
                  "if (j.access) pm.collectionVariables.set('access', j.access);",
                  "if (j.refresh) pm.collectionVariables.set('refresh', j.refresh);",
                  "pm.collectionVariables.set('user_id', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rafraîchir le token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
