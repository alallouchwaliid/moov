      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "email",
      "value": "nouveau@moov.ma"
    },
    {
      "key": "password",
      "value": "Moov!2026secure"
    },
    {
      "key": "trip_id",
      "value": ""
    },
    {
